  "stokastic_derived_metrics": {
    "verified_on": "2026-09-22",
    "value": {
      "formula": "fp - (salary / 1000 * 5)",
      "source": "https://www.stokastic.com/articles/nba-dfs/how-to-use-nba-dfs-projections",
      "quote": "Value = Fantasy Projection - (Salary / 1,000 x 5). Using that same $10,000 center at 55 points: 55 - (10 x 5) = a value of 5.0"
    },
    "points_per_dollar": {
      "formula": "fp / salary * 1000",
      "source": "https://www.stokastic.com/articles/nba-dfs/how-to-use-nba-dfs-projections",
      "quote": "Points per dollar (Pts/$) ... The formula is simple: Fantasy Points / Salary x 1,000. Say a top-tier center projects for 55 fantasy points at a $10,000 salary ... gives you 5.5 points per dollar."
    },
    "boom_threshold": {
      "formula": "5 * (salary / 1000) + 10",
      "source": "https://www.stokastic.com/articles/nba-dfs/nba-dfs-boom-bust-strategy",
      "quote": "Success ('boom') is reaching about 5 x (salary/1000) + 10 fantasy points ... a $9,000 player needs ~45 to clear value and ~55 to 'boom,' while a $4,000 punt only needs ~20 and ~30."
    },
    "bust_threshold": {
      "formula": "5 * (salary / 1000)",
      "source": "https://www.stokastic.com/articles/nba-dfs/nba-dfs-boom-bust-strategy",
      "quote": "failure ('bust') is falling short of 5 x (salary/1000)"
    },
    "ceiling_definition": {
      "formula": "75th percentile of the player's simulated outcome distribution",
      "source": "https://www.stokastic.com/articles/nba-dfs/nba-dfs-boom-bust-strategy",
      "quote": "Ceiling projection - the 75th-percentile outcome."
    },
    "floor_definition": {
      "formula": "25th percentile of the player's simulated outcome distribution",
      "source": "https://www.stokastic.com/articles/nba-dfs/nba-dfs-boom-bust-strategy",
      "quote": "Floor projection - the 25th-percentile outcome."
    },
    "implied_team_total": {
      "formula": "total/2 + spread/2 (favorite); total/2 - spread/2 (underdog)",
      "source": "https://www.stokastic.com/articles/nfl-dfs/nfl-dfs-defense-strategy",
      "quote": "worked example: 44 total with a -7 spread gives the favorite 25.5 and the underdog 18.5"
    }
  }
